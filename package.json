{
	"name": "track-the-hack-bot",
	"version": "1.0.0",
	"description": "A Discord bot that automatically assigns roles to verified hackers on the Hack the Hill server, integrating with the Track the Hack event management platform.",
	"main": "bot.js",
	"type": "module",
	"scripts": {
		"start": "node dist/bot.js",
		"build": "tsc && vite build",
		"test": "npm run build && node --test test/*.test.js",
		"evaluate:ai": "npm run build && node dist/evaluate-ai.js",
		"export:ai-corpus": "npm run build && node dist/export-ai-corpus.js",
		"sync:ai-corpus": "npm run build && node dist/sync-ai-corpus.js",
		"corpus:ui": "npm run build && node dist/ai-corpus-server.js",
		"evaluate:ai-blob": "npm run build && node dist/evaluate-ai-blob.js",
		"evaluate:ai-bakeoff-blob": "npm run build && node dist/evaluate-ai-bakeoff-blob.js",
		"replay:ai": "npm run build && node dist/replay-ai.js",
		"sync:embeddings": "npm run build && node dist/sync-embeddings.js",
		"migrate:db": "npm run build && node dist/migrate-db.js",
		"dev": "npx nodemon --exec npx tsx src/bot.ts",
		"register": "npx tsx src/register.ts"
	},
	"dependencies": {
		"@azure/identity": "^4.13.1",
		"@azure/storage-blob": "^12.33.0",
		"@fontsource/rubik": "^5.3.0",
		"body-parser": "^2.3.0",
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"pg": "^8.22.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"overrides": {
		"undici": "6.28.0"
	},
	"author": "Hack the Hill",
	"license": "MIT",
	"devDependencies": {
		"@types/body-parser": "^1.19.6",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	}
}
